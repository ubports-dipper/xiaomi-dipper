lxc.rootfs.path = /var/lib/lxc/android/rootfs
lxc.uts.name = armhf

lxc.log.syslog = daemon
# Uncomment for more debugging info.
# lxc.log.level = 3

lxc.net.0.type = none

# Make it possible for the Android container to access the internet.
# (Needed for A-GPS, VoLTE, ...)
lxc.namespace.keep = net user

lxc.tty.dir = lxc
lxc.tty.max = 4
lxc.pty.max = 1024
lxc.cap.drop = mac_admin mac_override

lxc.hook.pre-start = /var/lib/lxc/android/pre-start.sh
lxc.hook.mount = /var/lib/lxc/android/mount.sh
lxc.hook.post-stop = /var/lib/lxc/android/post-stop.sh

lxc.apparmor.profile = unconfined
lxc.autodev = 0

# Doing part of Android's first stage init
lxc.mount.entry = tmpfs dev tmpfs nosuid,mode=0755 0 0
lxc.mount.entry = /dev/__properties__ dev/__properties__ bind bind,create=dir 0 0
lxc.mount.entry = /dev/binderfs dev/binderfs bind bind,create=dir,optional 0 0
lxc.mount.entry = /dev/socket dev/socket bind bind,create=dir 0 0
lxc.mount.entry = proc proc proc nodev,noexec,nosuid 0 0
# Dipper: hide androidboot.mode=charger from Android's init (off-mode charging
# power-up), or it runs its charger actions and one of them ends in a sysrq
# emergency remount that leaves the host read-only. The file is written by
# /usr/libexec/dipper-android-charger-guard (ExecStartPre of lxc-android-config).
lxc.mount.entry = /run/dipper-android-cmdline proc/cmdline none bind,ro,optional 0 0
# Dipper: Android must not reach /proc/sysrq-trigger; an emergency remount
# ("u") from the container leaves every host filesystem read-only.
lxc.mount.entry = /dev/null proc/sysrq-trigger none bind,optional 0 0
lxc.mount.entry = sys sys sysfs nodev,noexec,nosuid 0 0
lxc.mount.entry = selinuxfs sys/fs/selinux selinuxfs optional 0 0
